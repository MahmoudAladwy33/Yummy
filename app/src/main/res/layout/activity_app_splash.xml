<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lottie="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/MainColor_lighter"
    android:background="#FFFFFF">


    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieView"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_centerInParent="true"
        lottie:lottie_autoPlay="true"
        lottie:lottie_fileName="AppSplash.json"
        lottie:lottie_loop="false" />


    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/lottieView"
        android:layout_centerHorizontal="true"
        android:alpha="0"
        android:fontFamily="@font/montserrat_regular"
        android:text="@string/AppName"
        android:textColor="@color/white"
        android:textSize="48sp" />
</RelativeLayout>
